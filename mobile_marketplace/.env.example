# Copie para `.env` na raiz de mobile_marketplace (`cp .env.example .env`).
#
# IMPORTANTE (Web + Metro proxy `/__ibix_api`): se EXPO_PUBLIC_API_BASE_URL apontar para
# 127.0.0.1 ou localhost e NÃO houver FastAPI rodando nessa máquina na porta indicada,
# o proxy devolve 502 Bad Gateway. Para só testar UI contra a API de produção, use os
# valores HTTPS/WSS abaixo (recomendado para PC tester sem backend local).

EXPO_PUBLIC_API_BASE_URL=https://www.ibix.com.br/api/v1
EXPO_PUBLIC_WS_BASE_URL=wss://www.ibix.com.br

# Backend local (VPS/dev com uvicorn na máquina atual):
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
# EXPO_PUBLIC_WS_BASE_URL=ws://127.0.0.1:8000

EXPO_PUBLIC_SENTRY_DSN=
# Google OAuth: o GET /loja/auth/social/config devolve só o Client ID **Web** (vitrine).
# No app nativo (Expo), o Google exige Client IDs separados no Cloud Console:
#   - EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID = mesmo ID da API (tipo "Aplicativo da Web") — obrigatório também no Android/iOS para o fluxo do expo-auth-session.
#   - EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID = credencial tipo **Android** (pacote com.ibix.market + SHA-1 debug/release).
#   - EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID = credencial tipo **iOS** (Bundle com.ibix.market).
# Sem Android/iOS, o login Google na web continua a funcionar; no telefone o Google bloqueia ("app inválido") se se usasse só o ID Web como se fosse nativo.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
