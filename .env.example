# PDV Ibix - Variáveis de ambiente (cópia como .env e ajuste os valores)
# Copiar: cp .env.example .env

# ========== ACESSO PELA INTERNET (obrigatório para produção) ==========
# URL pública da aplicação (sem barra no final). Usado em callbacks, Mercado Pago, billing.
# Domínio externo oficial em produção: www.ibix.com.br
APP_URL=https://www.ibix.com.br
# Domínio canônico para SEO (sem barra no final): canonical, Open Graph, sitemap, merchant-feed.
# Oficial da vitrine no Google deve ser o mesmo (ex.: ibix). Ajuste se APP_URL ou o host atrás do proxy divergirem.
# Recomendado em produção (descomente): alinha retorno e webhook da vitrine ao host público.
# SEO_PUBLIC_BASE_URL=https://www.ibix.com.br
# Hosts legados que recebem 301 para SEO_PUBLIC_BASE_URL (só rotas públicas: /loja, /login, sitemap…).
# Ex.: host antigo antes do multi-brand. NÃO inclua domínios ativos em brand_domains (ex.: www.solumatica.com.br).
# SEO_REDIRECT_LEGACY_HOSTS=host-legado.exemplo.com.br
# Opcional: all = redireciona quase tudo (exceto /api, /static, /dashboard, /admin) — pode quebrar sessão no host legado.
# SEO_REDIRECT_LEGACY_PATH_MODE=public
# Atrás de nginx/Cloudflare com TLS no proxy: permite que request.url use https e o Host correto.
# TRUST_PROXY_HEADERS=true
# Usar HTTPS em produção (headers HSTS, cookie secure)
HTTPS=true
# Ambiente: production ativa mensagens genéricas de erro e desativa stack trace
ENV=production
# CORS (Fase 5): mesclado com brand_domains ativos; nunca wildcard em produção
# CORS_ORIGINS=https://www.ibix.com.br,https://ibix.com.br,https://www.solumatica.com.br,https://solumatica.com.br
# CSP: hosts extras em connect-src; CSP_EXTRA_SOURCES concatena à policy OWASP
# CSP_CONNECT_SRC_HOSTS=
# CSP_EXTRA_SOURCES=
# RLS_ENABLED: ativar após migração br35_rls_policies + role pdv_app (Fase 9)
# RLS_ENABLED=false
# ENTERPRISE_STRICT_STARTUP=false  # true em prod após role pdv_app + segredos OK
# SECRETS_DIR=/etc/pdv/secrets      # arquivos opcionais (modo 0600) — fallback após env
# SECRETS_BACKEND=env               # futuro: vault|aws

# ========== Banco PostgreSQL ==========
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pdv_solumatica
DB_USER=postgres
# Senha do usuário postgres (igual à configurada no servidor PostgreSQL)
DB_PASSWORD=autom081530Re#
# Desenvolvimento com Docker: use DB_NAME=pdv_automscale se subir só o compose (db).
# Pool: total = (workers_gunicorn + workers_celery) × (DB_POOL_SIZE + DB_MAX_OVERFLOW). Deve ser < max_connections (SHOW max_connections; no PostgreSQL).
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT=10
# Timeout por statement (ms) via SET LOCAL em cada request — noisy-neighbor / Fase 3.2
# DB_STATEMENT_TIMEOUT_MS=30000
# Log de queries lentas (ms) com brand_slug/tenant_id/request_id em logs/pdv_solumatica.log
# DB_SLOW_QUERY_MS=500
# Gatilho particionamento: ver comentário em br33_performance_indexes.py (~10M linhas vendas/pedidos_marketplace)

# ========== Redis + Celery ==========
# Redis é OPCIONAL para a aplicação web: cache (subscription_blocked, permissões), rate limit e
# blacklist de tokens usam Redis com fallback (memória/DB). Só é OBRIGATÓRIO se rodar Celery worker
# (tarefas assíncronas: PDF, billing, NFS-e, etc.). Sem Redis: app funciona; rate limit fica por processo.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
# Prefixo das chaves no Redis (cache, rate limit, blacklist). Evita colisão se o mesmo Redis for compartilhado.
# REDIS_KEY_PREFIX=pdv:
# Timeout de socket em segundos (conexão e leitura). Evita travar worker se Redis estiver lento.
# REDIS_TIMEOUT=2
# Máximo de conexões no pool por processo (desempenho e limite no Redis).
# REDIS_MAX_CONNECTIONS=20

# ========== Webhook billing (assinatura + idempotência) — E5.4 ==========
# Gerar um segredo forte e configurar no gateway de billing
# WEBHOOK_BILLING_SECRET=

# ========== Mercado Pago (assinatura PDV Ibix) ==========
# MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET=
# Webhook URL: https://www.ibix.com.br/api/webhooks/mercadopago

# ========== Criptografia em repouso (Fase 4 LGPD) ==========
# Obrigatório em ENV=production para tokens de gateway e segredos billing no banco.
# Gerar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# PAYMENT_CREDENTIALS_SECRET=
# Alternativa (deriva chave): PAYMENT_CREDENTIALS_PASSWORD=
# Senha certificado A1 (separada): FISCAL_CERT_PASSWORD_SECRET= ou FISCAL_CERT_PASSWORD_PASSWORD=

# ========== PagBank Connect (OAuth gateway de vendas) ==========
# Credenciais da aplicação PagBank Connect (obtidas em https://developer.pagbank.com.br/).
# Usadas no fluxo OAuth (CA conecta conta): o CA será redirecionado ao PagBank para autorizar.
# PAGBANK_CONNECT_CLIENT_ID=
# PAGBANK_CONNECT_CLIENT_SECRET=
# Sandbox: true para ambiente de testes, false para produção.
# PAGBANK_CONNECT_SANDBOX=true

# ========== Página Planos (opcional) ==========
# URL do gateway de pagamento; use {plan_slug} como placeholder
# GATEWAY_CHECKOUT_URL=https://gateway.example.com/checkout?plan={plan_slug}

# ========== CRM Automscale (leads Fale conosco - landing) ==========
# Chave fornecida pelo CRM; usar apenas no servidor (nunca no HTML/JS).
# Se definida, o formulário Fale conosco envia lead para o CRM além do e-mail.
# CRM_SITE_LEAD_SECRET=
# URL do endpoint (alterar só se o CRM avisar)
# CRM_SITE_LEAD_URL=https://crm.automscale.com.br/api/v1/sales/leads/site

# ========== Rate limit (teste de carga / desenvolvimento) ==========
# Para testes Locust: aumente para não bloquear 127.0.0.1 (ex.: 500). Produção: deixe padrão (10, 5, 10).
# LOGIN_RATE_LIMIT_MAX=500
# LOJA_LOGIN_RATE_LIMIT_MAX=500
# LOJA_CHECKOUT_RATE_LIMIT_MAX=500

# ========== Vitrine / login social (Consumidor Final) ==========
# Google: OAuth 2.0 Client ID (tipo Aplicativo da Web). Console → APIs e serviços → Credenciais.
# Client ID é público (exposto em GET /api/v1/loja/auth/social/config). Secret só no servidor — nunca no front.
# LOJA_OAUTH_GOOGLE_CLIENT_ID=
# LOJA_OAUTH_GOOGLE_CLIENT_SECRET=
# Origens JS / redirect: ver MAPA_SISTEMA/MAPA_GOOGLE_OAUTH_VITRINE.md
# LOJA_OAUTH_FACEBOOK_APP_ID=
# LOJA_OAUTH_APPLE_CLIENT_ID=

# ========== Google Custom Search (busca de imagem no cadastro de produto / estoque) ==========
# API Key + Search engine ID (cx) em Google Cloud Console + Programmable Search Engine (searchType=image).
# Fallback quando não houver valores na tabela configuracoes (painel Superadmin: /admin/integracoes/google-custom-search).
# Sem key+cx em lugar nenhum, GET /api/v1/integracoes/google-custom-search-imagens retorna 503.
# Chave de API (Credenciais → Chave de API; formato típico AIza...). Não usar chave AQ... nem OAuth.
# GOOGLE_CUSTOM_SEARCH_API_KEY=
# GOOGLE_CUSTOM_SEARCH_ENGINE_ID=


# ========== Fiscal / SEFAZ (NF-e) ==========
# Por padrão a verificação SSL usa certifi-icpbr (CAs Mozilla + ICP-Brasil), adequado para SEFAZ.
# Apenas em homologação/desenvolvimento, se ainda houver falha de certificado, desative (não use em produção):
# SEFAZ_SSL_VERIFY=false

# ========== Logs ==========
# LOG_LEVEL=INFO
# DEBUG=false
